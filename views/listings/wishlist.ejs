<% layout("/layouts/boilerplate") %>


<div class="container mt-5">
  <h2>My Wishlist ❤️</h2>

  <% if(wishlist.length===0){ %>
    <p class="text-muted mt-3">No listings added to wishlist yet.</p>
  <% } %>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-4">
    <% wishlist.forEach(listing=>{ %>
        
      <div class="col mb-4">
        <div class="card">
            <div class="wishlist-image-box">
          <img src="<%= listing.image.url %>" class="card-img-top wishlist-image">
          </div>
          <div class="card-body">
            <h5><%= listing.title %></h5>
            <p><%= listing.location %>, <%= listing.country %></p>
            <a href="/listings/<%= listing._id %>" class="btn btn-dark">
              View Listing
            </a>
           <button
    class="btn btn-outline-danger mt-2"
    onclick="removeFromWishlist('<%= listing._id %>',this)">
    <i class="fa-solid fa-heart-crack"></i>
    Remove
  </button>
</div>
            
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>



<script>
async function removeFromWishlist(listingId,button){
  try{
    const response=await fetch(`/wishlist/${listingId}`,{
      method:"DELETE"
    });

    const data=await response.json();

    if(data.success){
      button.closest(".col").remove();
    }
  }catch(error){
    console.log(error);
  }
}
</script>