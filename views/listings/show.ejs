<% layout("/layouts/boilerplate") %>


<div class="row mt-3">

  <!-- LISTING TITLE -->
  <div class="col-8 offset-3">
    <h3 class="listing-title">
      <%= listing.title %>
    </h3>
  </div>

  <!-- LISTING CARD -->
  <div class="card col-6 offset-3 show-card listing-card">

    <div class="image-wrapper">
      <img src="<%= listing.image.url %>"
           class="card-img-top show-img"
           alt="listing_image">

      <div class="image-overlay">
        <span>
          <i class="fa-solid fa-camera"></i>
          StayNest
        </span>
      </div>
    </div>

    <div class="card-body">

      <!-- OWNER -->
      <p class="card-text owner-info">
        <span class="info-icon">
          <i class="fa-solid fa-user"></i>
        </span>
        <i>Owned by <strong><%= listing.owner.username %></strong></i>
      </p>

      <!-- DESCRIPTION -->
      <p class="card-text description">
        <%= listing.description %>
      </p>

      <!-- PRICE -->
      <div class="price-box">
        <span class="price">
          &#8377;<%= listing.price.toLocaleString("en-IN") %>
        </span>
        <span class="per-night"> / night</span>
      </div>

      <!-- LOCATION -->
      <p class="card-text location-info">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>
      </p>

      <!-- COUNTRY -->
      <p class="card-text country-info">
        <i class="fa-solid fa-globe"></i>
        <%= listing.country %>
      </p>

    </div>
  </div>


  <!-- EDIT DELETE -->
  <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>

    <div class="btns listing-actions">

      <a href="/listings/<%= listing._id %>/edit"
         class="btn btn-dark edit-btn">
        <i class="fa-solid fa-pen"></i>
        Edit
      </a>

      <form method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE">

        <button class="btn btn-dark delete-listing-btn">
          <i class="fa-solid fa-trash"></i>
          Delete
        </button>

      </form>

    </div>

  <% } %>


  <!-- REVIEW SECTION -->
  <div class="col-8 offset-3 mb-3 review-section">

    <hr>

    <% if(currentUser) { %>

      <h4 class="review-heading">
        <i class="fa-regular fa-star"></i>
        Leave a Review
      </h4>

      <hr>

      <form action="/listings/<%= listing.id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation review-form">

  
        <!-- RATING -->
        <div class="mb-3 mt-3">

          <label class="form-label rating-label">
            Rating
          </label>

          <fieldset class="starability-slot">

            <input type="radio"
                   id="first-rate1"
                   name="review[rating]"
                   value="1">

            <label for="first-rate1"
                   title="Terrible">
              1 star
            </label>


            <input type="radio"
                   id="first-rate2"
                   name="review[rating]"
                   value="2">

            <label for="first-rate2"
                   title="Not good">
              2 stars
            </label>


            <input type="radio"
                   id="first-rate3"
                   name="review[rating]"
                   value="3">

            <label for="first-rate3"
                   title="Average">
              3 stars
            </label>


            <input type="radio"
                   id="first-rate4"
                   name="review[rating]"
                   value="4">

            <label for="first-rate4"
                   title="Very good">
              4 stars
            </label>


            <input type="radio"
                   id="first-rate5"
                   name="review[rating]"
                   value="5">

            <label for="first-rate5"
                   title="Amazing">
              5 stars
            </label>

          </fieldset>

        </div>


        <!-- COMMENT -->
        <div class="mb-3 mt-3">

          <label for="comment"
                 class="form-label">
            Comments
          </label>

          <textarea name="review[comment]"
                    id="comment"
                    cols="30"
                    rows="5"
                    class="form-control review-input"
                    placeholder="Share your experience..."
                    required></textarea>

          <div class="invalid-feedback">
            Please add some comments for review
          </div>

        </div>


        <!-- SUBMIT -->
        <button class="btn btn-outline-dark submit-review-btn">

          <i class="fa-solid fa-paper-plane"></i>
          Submit Review

        </button>

      </form>

      <hr>

    <% } %>


    <!-- ALL REVIEWS -->
    <div class="reviews-header">

      <h4>
        <i class="fa-solid fa-comments"></i>
        All Reviews
      </h4>

      <span class="review-count">
        <%= listing.reviews.length %>
        Review<%= listing.reviews.length !== 1 ? "s" : "" %>
      </span>

    </div>


    <div class="row">

      <% for (review of listing.reviews) { %>

        <div class="card col-5 ms-3 mb-3 review-card">

          <div class="card-body">


            <!-- USER -->
            <div class="review-user">

              <div class="user-avatar">

                <%= review.author.username.charAt(0).toUpperCase() %>

              </div>

              <div>

                <h5 class="card-title">

                  @<%= review.author.username %>

                </h5>

                <small>
                  Verified Guest
                </small>

              </div>

            </div>


            <!-- RATING -->
            <div class="review-rating">

              <p class="starability-result"
                 data-rating="<%= review.rating %>">
              </p>

              <span class="rating-number">
                <%= review.rating %>/5
              </span>

            </div>


            <!-- COMMENT -->
            <p class="card-text review-comment">

              "<%= review.comment %>"

            </p>


            <!-- DELETE -->
            <form class="mb-3"
                  method="POST"
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

              <button class="btn btn-sm btn-dark review-delete-btn">

                <i class="fa-solid fa-trash"></i>
                Delete

              </button>

            </form>

          </div>

        </div>

      <% } %>

    </div>
  
   </div>
   <!--  <div class="col-8 offset-3 mb-3">
    <h3>Where You'll be</h3>
    <div id="map"></div>
   </div> -->

  </div>

</div>