<% layout("/layouts/boilerplate") %>


<style>
    .edit-listing-page {
        min-height: 100vh;
        padding: 40px 0 70px;
        background: linear-gradient(135deg, #f8f9fa, #eef1f5);
    }

    .edit-card {
        max-width: 850px;
        margin: auto;
        background: #fff;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #eee;
    }

    .page-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .header-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #111;
        color: #fff;
        font-size: 26px;
    }

    .page-header h2 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .page-header p {
        color: #777;
        margin: 0;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        margin: 30px 0 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #ddd;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        border-color: #111;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .current-image {
        margin-top: 10px;
        padding: 10px 14px;
        background: #f8f8f8;
        border-radius: 10px;
        font-size: 13px;
        color: #777;
        word-break: break-all;
    }

    .input-group-text {
        background: #f8f8f8;
        border-color: #ddd;
        border-radius: 12px 0 0 12px;
    }

    .input-group .form-control {
        border-radius: 0 12px 12px 0;
    }

    .edit-btn {
        width: 100%;
        padding: 14px;
        border-radius: 13px;
        font-size: 16px;
        font-weight: 600;
        margin-top: 15px;
        transition: all 0.2s ease;
    }

    .edit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .back-btn {
        display: block;
        text-align: center;
        margin-top: 15px;
        color: #666;
        text-decoration: none;
        font-size: 14px;
    }

    .back-btn:hover {
        color: #111;
    }

 .current-image-preview img {
    width: 200px;
    height: 150px;
    object-fit: cover;
    border-radius: 10px;
    display: block;
}

    @media (max-width: 768px) {
        .edit-listing-page {
            padding: 20px 10px 50px;
        }

        .edit-card {
            padding: 25px 20px;
            border-radius: 18px;
        }
    }
</style>


<div class="edit-listing-page">

    <div class="container">

        <div class="edit-card">

            <!-- Header -->
            <div class="page-header">

                <div class="header-icon">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>

                <h2>Edit Your Listing</h2>

                <p>Update your property details and keep your listing fresh.</p>

            </div>


            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=PUT"
                novalidate
                class="needs-validation"
                enctype="multipart/form-data"
            >

                <!-- BASIC INFORMATION -->
                <div class="section-title">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Basic Information
                </div>


                <!-- Title -->
                <div class="mb-4">

                    <label for="title" class="form-label">
                        Listing Title
                    </label>

                    <input
                        id="title"
                        name="listing[title]"
                        value="<%= listing.title %>"
                        placeholder="Enter listing title"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="valid-feedback">
                        Title looks good!
                    </div>

                    <div class="invalid-feedback">
                        Please enter a listing title.
                    </div>

                </div>


                <!-- Description -->
                <div class="mb-4">

                    <label for="description" class="form-label">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="listing[description]"
                        placeholder="Describe your property..."
                        class="form-control"
                        required
                    ><%= listing.description %></textarea>

                    <div class="invalid-feedback">
                        Please enter a short description.
                    </div>

                </div>


                <!-- IMAGE -->

                
                <div class="section-title">
                    <i class="fa-solid fa-image me-2"></i>
                    Property Image 
                </div>

                <div class="mb-1 current-image-preview">
                    Original Listing Image
                    <img src="<%= originalImageUrl %>" 
                    alt="Property Image">
                 </div>



                <div class="mb-4">

                    <label for="image" class="form-label">
                       Upload Image
                    </label>

                    <input
                        id="image"
                        name="listing[image]"
                        placeholder="Enter image URL"
                        type="file"
                        class="form-control"
                        
                    >
                     <div class="current-image">
                        <i class="fa-solid fa-link me-1"></i>
                        Current image URL is shown above
                    </div>

                </div>


                <!-- LOCATION & PRICE -->
                <div class="section-title">
                    <i class="fa-solid fa-location-dot me-2"></i>
                    Location & Pricing
                </div>


                <div class="row">

                    <!-- Price -->
                    <div class="mb-4 col-md-5">

                        <label for="price" class="form-label">
                            Price per night
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input
                                id="price"
                                name="listing[price]"
                                value="<%= listing.price %>"
                                type="number"
                                min="1"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="invalid-feedback">
                            Please enter a valid price.
                        </div>

                    </div>


                    <!-- Country -->
                    <div class="mb-4 col-md-7">

                        <label for="country" class="form-label">
                            Country
                        </label>

                        <input
                            id="country"
                            name="listing[country]"
                            value="<%= listing.country %>"
                            type="text"
                            class="form-control"
                            required
                        >

                        <div class="invalid-feedback">
                            Please enter a valid country.
                        </div>

                    </div>

                </div>


                <!-- LOCATION -->
                <div class="mb-4">

                    <label for="location" class="form-label">
                        Location
                    </label>

                    <input
                        id="location"
                        name="listing[location]"
                        value="<%= listing.location %>"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid location.
                    </div>

                </div>

                <div class="mb-3">
  <label for="category" class="form-label">Category</label>
  <select name="listing[category]" id="category" class="form-select" required>
    <option value="">Select a category</option>
    <option value="Rooms" <%= listing.category==="Rooms" ? "selected" : "" %>>🛏️ Rooms</option>
    <option value="Homes" <%= listing.category==="Homes" ? "selected" : "" %>>🏠 Homes</option>
    <option value="Nature" <%= listing.category==="Nature" ? "selected" : "" %>>🏔️ Nature</option>
    <option value="Beach" <%= listing.category==="Beach" ? "selected" : "" %>>🏖️ Beach</option>
    <option value="City" <%= listing.category==="City" ? "selected" : "" %>>🏙️ City</option>
    <option value="Vacation" <%= listing.category==="Vacation" ? "selected" : "" %>>🌴 Vacation</option>
    <option value="Camping" <%= listing.category==="Camping" ? "selected" : "" %>>⛺ Camping</option>
  </select>
</div>


                <!-- BUTTON -->
                <button
                    type="submit"
                    class="btn btn-dark edit-btn"
                >
                    <i class="fa-solid fa-check me-2"></i>
                    Save Changes
                </button>


                <a href="/listings/<%= listing._id %>" class="back-btn">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Back to Listing
                </a>

            </form>

        </div>

    </div>

</div>

